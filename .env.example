# Copie para .env. O arquivo .env nunca deve ir para o git.

# demo = dados fictícios (padrão) | live = APIs reais
YTI_MODE=demo

# Chave da YouTube Data API v3 (Google Cloud Console > Credenciais)
YOUTUBE_API_KEY=

# Caminho do client_secret.json do OAuth (app para computador). Só para canais próprios.
YOUTUBE_OAUTH_CLIENT_SECRETS=

# Preencha SOMENTE depois que o Google aceitar o uso analítico (Derived Metrics Policy).
# Sem isto, no modo live, scores e VPH ficam bloqueados e a retenção é de 30 dias.
YTI_DERIVED_METRICS_APPROVAL_REF=

# Geração por IA: none | anthropic | claude_cli
#   none        modelo sem IA, sem custo (padrão)
#   anthropic   API paga, precisa de ANTHROPIC_API_KEY
#   claude_cli  usa o comando `claude` já autenticado nesta máquina, sem ferramentas
YTI_AI_PROVIDER=none
YTI_AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Limites diários locais de cota, abaixo dos limites do Google por segurança
YTI_QUOTA_DEFAULT_DAILY=9000
YTI_QUOTA_SEARCH_DAILY=90
